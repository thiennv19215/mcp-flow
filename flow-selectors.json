{
  "version": 2,
  "description": "Google Flow Complete Dynamic Selectors Configuration (TobyFlow Compatible)",
  "updatedAt": "2026-10-21T09:00:00Z",
  "editor": {
    "selectors": [
      ".ProseMirror[contenteditable='true']",
      ".ProseMirror",
      "flow-base-prompt-box [contenteditable='true']",
      "textarea[aria-label*='prompt']"
    ]
  },
  "composerRoot": {
    "selectors": [
      ".flow-composer",
      "flow-base-prompt-box",
      "form[class*='composer']",
      "[class*='composer']"
    ]
  },
  "submitButton": {
    "selectors": [
      "button[type='submit']",
      "button[data-action='submit']",
      "button[data-action='generate']",
      "button",
      "[role='button']"
    ],
    "icons": ["arrow_forward", "arrow_upward", "send", "sparkle", "auto_awesome", "play_arrow", "north", "east"],
    "textRegex": "^(?:start generation|generate|bắt đầu tạo|tạo video|tạo ảnh|tạo hình ảnh)$",
    "nearComposerTextRegex": "^(?:create|tạo)$",
    "excludedTextRegex": "(?:project|dự án|character|nhân vật|folder|thư mục|settings|cài đặt|tune|clear prompt|xóa câu lệnh|xóa văn bản|quay lại|back|upload|tải lên)",
    "excludedComposerIcons": ["tune", "settings", "close", "clear", "add", "add_circle"],
    "excludedComposerAria": "setting|cài đặt|clear|xóa|thành phần|ingredient|add media"
  },
  "tiles": {
    "container": {
      "selectors": [
        "flow-grid-tile-container",
        "[class*='grid-tile-container']",
        "[class*='grid-tile']"
      ],
      "attribute": "data-tile-id"
    },
    "progressBar": {
      "selectors": [
        "flow-progress-tile",
        "mat-progress-bar",
        "[role='progressbar']",
        "[class*='progress-bar']",
        "[class*='progressbar']"
      ]
    },
    "spinner": {
      "selectors": [
        "mat-spinner",
        "mat-progress-spinner",
        "[class*='spinner']",
        "[class*='loading']",
        "[class*='loader']",
        "[class*='shimmer']",
        "[class*='skeleton']",
        "svg[class*='spin']"
      ]
    },
    "placeholder": {
      "selectors": [
        "flow-progress-tile",
        "flow-rendering-tile",
        "flow-generating-tile",
        "flow-placeholder-tile",
        "[class*='rendering']",
        "[class*='generating']",
        "[class*='placeholder']"
      ]
    },
    "error": {
      "selectors": [
        "flow-error-tile",
        "[class*='error-tile']",
        "[class*='error']",
        "[class*='failed']",
        "[class*='warning-tile']",
        "[role='alert']"
      ]
    },
    "video": {
      "selectors": [
        "flow-video-tile",
        "flow-scene-tile"
      ]
    },
    "scene": {
      "selectors": [
        "flow-scene-tile"
      ]
    },
    "image": {
      "selectors": [
        "flow-image-tile",
        "img"
      ]
    },
    "mediaElements": {
      "selectors": [
        "video",
        "img",
        "canvas",
        "[role='img']",
        "flow-video-tile",
        "flow-image-tile"
      ]
    },
    "retryButton": {
      "selectors": ["button", "[role='button']"],
      "textRegex": "^(?:retry|try again|thử lại)(?:\\s+.*)?$",
      "iconRegex": "refresh|replay|retry"
    }
  },
  "settings": {
    "triggerButton": {
      "selectors": ["button", "[role='button']"],
      "icon": "tune"
    },
    "panel": {
      "selectors": [
        "[role='dialog']",
        "[role='menu']",
        "mat-dialog-container",
        "flow-dialog",
        ".cdk-overlay-pane",
        "mat-menu-panel"
      ]
    },
    "options": {
      "selectors": [
        "[role='radio']",
        "mat-radio-button",
        "[role='tab']"
      ]
    },
    "optionCandidates": {
      "selectors": [
        "[role='radio']",
        "mat-radio-button",
        "[role='tab']",
        "[role='option']",
        "button",
        "[role='button']"
      ]
    },
    "dropdownItems": {
      "selectors": [
        "[role='menuitem']",
        "[role='menuitemradio']",
        "mat-option",
        "[role='option']"
      ]
    },
    "activeMenu": {
      "selectors": [
        "[role='menu']:last-of-type",
        "[data-radix-popper-content-wrapper]:last-of-type",
        ".cdk-overlay-pane:last-of-type"
      ]
    },
    "durationTrigger": {
      "selectors": [
        "button[id*='-trigger-']"
      ]
    }
  },
  "components": {
    "inlineChips": {
      "selectors": [
        "[contenteditable=\"false\"]",
        "button[aria-label=\"Ingredient\"]",
        "button[aria-label=\"Thành phần\"]",
        "button[aria-label=\"Nguyên liệu\"]",
        "[class*=\"ingredient-chip\"]"
      ]
    },
    "characterTile": {
      "selectors": [
        "flow-character-tile"
      ]
    },
    "listBox": {
      "selectors": [
        "[role=\"listbox\"]",
        "mat-select-panel"
      ]
    },
    "optionItem": {
      "selectors": [
        "[role=\"option\"]",
        "mat-option"
      ]
    },
    "voiceChip": {
      "selectors": [
        "[data-ingredient-type=\"voice\"]",
        "[data-kind=\"voice\"]",
        "[class*=\"voice-chip\" i]",
        "button[aria-label*=\"voice\" i]",
        "button[aria-label*=\"giọng\" i]"
      ]
    },
    "voiceRemoveButton": {
      "selectors": [
        "button[aria-label*=\"remove\" i]",
        "button[aria-label*=\"delete\" i]",
        "button[aria-label*=\"xóa\" i]",
        "[role=\"button\"][aria-label*=\"remove\" i]"
      ]
    },
    "categoryTabs": {
      "selectors": [
        "[role=\"tab\"]",
        "button"
      ]
    },
    "searchInput": {
      "selectors": [
        "input",
        "[role=\"textbox\"]"
      ],
      "textRegex": "(?:search assets|tìm kiếm|search)"
    },
    "dialog": {
      "selectors": [
        "[role=\"dialog\"]",
        "mat-dialog-container",
        "flow-dialog"
      ]
    },
    "actionMenus": {
      "selectors": [
        "[role=\"menu\"]",
        "mat-menu-panel",
        ".cdk-overlay-pane"
      ]
    },
    "actionMenuItems": {
      "selectors": [
        "[role=\"menuitem\"]",
        "button",
        "[role=\"button\"]"
      ]
    },
    "chips": {
      "selectors": [
        "button[aria-label=\"Ingredient\"]",
        "button[aria-label=\"Thành phần\"]",
        "button[aria-label=\"Nguyên liệu\"]",
        "button",
        "[role=\"button\"]"
      ]
    }
  },
  "characters": {
    "createTile": {
      "selectors": ["flow-custom-tile"]
    },
    "characterTile": {
      "selectors": ["flow-character-tile"]
    },
    "portrait": {
      "selectors": [
        "img[aria-label='Generated character image']",
        "img[aria-label='Ảnh nhân vật đã tạo']",
        "img[aria-label*='nhân vật']",
        "img[aria-label*='character']"
      ]
    },
    "nameInput": {
      "selectors": [
        "input",
        "[role=\"textbox\"]"
      ],
      "textRegex": "(?:Character name|Tên nhân vật)"
    },
    "personalityInput": {
      "selectors": [
        "textarea",
        "input",
        "[role=\"textbox\"]"
      ],
      "textRegex": "(?:Character personality|Tính cách nhân vật|Mô tả nhân vật)"
    },
    "searchInput": {
      "selectors": [
        "input",
        "[role=\"textbox\"]"
      ]
    }
  },
  "mediaMenu": {
    "triggerButton": {
      "selectors": ["button", "[role='button']"],
      "icons": ["more_vert", "more_horiz", "more"]
    },
    "menuPanel": {
      "selectors": ["[role='menu']", "mat-menu-panel"]
    },
    "menuItems": {
      "selectors": ["[role='menuitem']", "button", "[role='button']"]
    },
    "menuItemLabel": {
      "selectors": [".label", ".item-text"]
    },
    "removeIcons": {
      "selectors": ["mat-icon", ".mat-icon", "svg", ".google-symbols"]
    }
  },
  "navigation": {
    "newProjectButton": {
      "selectors": ["button", "a[role='button']"],
      "icons": ["add", "create", "new"],
      "textRegex": "new project|tạo dự án|dự án mới|create project"
    },
    "scrollContainer": {
      "selectors": [
        "[class*='scroll']",
        "main",
        ".flow-scroll-container",
        "flow-app"
      ]
    },
    "navContainer": {
      "selectors": [
        "nav",
        "[role='navigation']",
        "mat-sidenav"
      ]
    },
    "backButton": {
      "selectors": ["button", "[role='button']"],
      "icons": ["arrow_back", "arrow-back", "back"]
    },
    "dialogCloseButton": {
      "selectors": ["button", "[role='button']"],
      "icons": ["close", "clear"]
    },
    "overlayBackdrop": {
      "selectors": [
        ".cdk-overlay-backdrop.cdk-overlay-backdrop-showing",
        ".cdk-overlay-backdrop"
      ]
    },
    "projectLinks": {
      "selectors": [
        "a[href*='/project/']"
      ]
    }
  },
  "creditLimit": {
    "selectors": [
      "[role='alert']",
      "mat-error",
      ".flow-alert",
      "[class*='alert']",
      "[class*='error']",
      "[class*='quota']",
      "[class*='credit']"
    ],
    "patterns": [
      "run out of credits",
      "no credits remaining",
      "not enough credits",
      "credit limit reached",
      "bạn đã hết credit",
      "không đủ credit",
      "hết hạn mức credit",
      "public_error_user_quota_reached"
    ]
  },
  "agent": {
    "toggleButton": {
      "selectors": ["button", "[role='button']"],
      "textRegex": "^Agent$"
    },
    "closeButton": {
      "selectors": ["button", "[role='button']"],
      "icon": "close"
    },
    "instructionDoneButton": {
      "selectors": ["button", "[role='button']"],
      "textRegex": "^(?:Done|Xong|Hoàn tất)$"
    }
  },
  "common": {
    "icons": {
      "selectors": [
        "mat-icon",
        ".mat-icon",
        ".google-symbols",
        ".material-symbols-outlined",
        "i",
        "svg"
      ]
    },
    "buttons": {
      "selectors": [
        "button",
        "[role='button']",
        "a[role='button']"
      ]
    },
    "loadingIndicator": {
      "selectors": [
        "[role='progressbar']",
        "[aria-busy='true']"
      ]
    },
    "headings": {
      "selectors": [
        "h1",
        "h2",
        "[role='heading']"
      ]
    },
    "textboxes": {
      "selectors": [
        "input",
        "textarea",
        "[role='textbox']"
      ]
    },
    "dialogs": {
      "selectors": [
        "[role='dialog']",
        "mat-dialog-container",
        "flow-dialog",
        "[aria-modal='true']"
      ]
    },
    "menus": {
      "selectors": [
        "[role='menu']",
        "mat-menu-panel",
        ".cdk-overlay-pane"
      ]
    }
  }
}