# Copy to .env on the VPS, then replace every CHANGE_ME value with a unique secret.
FLOW_MCP_HOST=0.0.0.0
FLOW_MCP_PORT=18899
FLOW_MCP_DOMAIN=flow.example.com
FLOW_MCP_PUBLIC_URL=https://flow.example.com
FLOW_MCP_ALLOWED_HOSTS=flow.example.com,127.0.0.1:18899
FLOW_MCP_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
FLOW_MCP_ADMIN_USER=admin
FLOW_MCP_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
FLOW_MCP_WS_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
FLOW_MCP_DB_PATH=/data/flow-users.sqlite
FLOW_MCP_TRUST_PROXY=true

# Persistent data paths inside the container.
FLOW_MCP_HOME=/data/.flow-mcp
FLOW_MCP_OUTPUT=/data/output
