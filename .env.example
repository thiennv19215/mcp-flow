# Copy to .env on the VPS, then replace every CHANGE_ME value with a unique secret.
FLOW_AUTH_PUBLISH_PORT=18899
FLOW_AUTH_PORT=18900
FLOW_AUTH_PUBLIC_URL=https://flow.example.com
FLOW_AUTH_ALLOWED_HOSTS=flow.example.com,127.0.0.1:18900,localhost:18900
FLOW_AUTH_ADMIN_USER=admin
FLOW_AUTH_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
FLOW_MCP_DB_PATH=/data/flow-users.sqlite
FLOW_AUTH_TRUST_PROXY=true

# Persistent account database path inside the container.
FLOW_MCP_HOME=/data/.flow-mcp
