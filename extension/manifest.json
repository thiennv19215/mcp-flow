{
  "manifest_version": 3,
  "name": "Flow MCP Native Automation",
  "version": "0.2.17",
  "minimum_chrome_version": "116",
  "description": "Flow MCP with browser-side automation handlers in a Chrome extension.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content/flow-upload-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content/slate-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content/dom-utils.js",
        "content/activity-overlay.js",
        "content/native-file-transfer.js",
        "content/flow-page-driver.js",
        "content/flow-driver-registry.js",
        "content/flow-v2-driver.js",
        "content/settings-actions.js",
        "content/asset-actions.js",
        "content/upload-actions.js",
        "content/download-actions.js",
        "content/reference-actions.js",
        "content/character-actions.js",
        "content/image-actions.js",
        "content/video-actions.js",
        "content/submit-actions.js",
        "content/agent-actions.js",
        "content/dom-actions.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "ui/options.html",
  "action": {
    "default_title": "Flow MCP Native Automation",
    "default_popup": "ui/popup.html"
  }
}
